# ==============================================================================
# MCU Inventory System - Environment Variables
# ==============================================================================

# General Django Settings
SECRET_KEY=generate_a_random_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# OPTION A: Local MariaDB / MySQL Configuration (default)
# ------------------------------------------------------------------------------
DB_NAME=mcu_inventory
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false

# ------------------------------------------------------------------------------
# OPTION B: TiDB Cloud Serverless Configuration
# ------------------------------------------------------------------------------
# DB_NAME=mcu_inventory
# DB_USER=your_prefix.root
# DB_PASSWORD=your_tidb_password
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_SSL=true

# ------------------------------------------------------------------------------
# Initial Admin Credentials (Optional for deployment / auto-seed)
# ------------------------------------------------------------------------------
# ADMIN_USER=admin
# ADMIN_PASSWORD=your_admin_password
# ADMIN_EMAIL=admin@example.com
